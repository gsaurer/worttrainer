# Copy this file to .env beside package.json. Never commit the populated .env.
# npm run dev, npm start, npm run reset-password, and Docker Compose read it.
# Existing shell/container environment variables take precedence over this file.
#
# Local development works with the defaults; leave these overrides commented.
# For production, set APP_ORIGIN to your exact HTTPS origin and COOKIE_SECURE=true.
# APP_ORIGIN=https://words.example.com
# COOKIE_SECURE=true
# DATA_FILE=data/store.json
# Set to 1 only behind exactly one trusted reverse proxy; do not expose its backend port publicly.
# TRUST_PROXY=0

# Optional fixed first-install secret, instead of a generated 15-minute link.
# Generate a random value (32-128 letters/digits/_/-); never use a memorable word.
# SETUP_TOKEN=
# Valid until the first parent account is created. Remove it after setup.

# Optional photo reading: create an Azure Document Intelligence Free/F0 resource.
# Never use paid S0 credentials. Leave both empty for manual-only review.
OCR_AZURE_ENDPOINT=
OCR_AZURE_KEY=
# Hard in-app UTC calendar-month budget, including failed/uncertain submissions.
# Maximum 450, below the currently advertised 500-page F0 allowance.
OCR_MONTHLY_LIMIT=450
